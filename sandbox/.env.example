# Copy to sandbox/.env and fill in. scripts/setup_games.sh writes the game paths for you.
# Never commit sandbox/.env.

# --- inference providers (only the ones for the models you run are required)
OPENROUTER_API_KEY=
BASETEN_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- shared secret between each orchestrator and its eval-service. Agents never receive it.
EVAL_RESET_SECRET=change-me

# --- game checkouts (absolute paths; written by scripts/setup_games.sh)
STX_REPO=
STX_BUILD_DIR=
TUX_DIR=
STK_DIR=

# --- agent network. Change only if 172.18.0.0/16 is already used on this host. Gemini arms reach
# the host-side schema proxy (tools/gemini_schema_proxy.py, port 8790) at the gateway address.
AGENTNET_SUBNET=172.18.0.0/16
AGENTNET_GATEWAY=172.18.0.1
