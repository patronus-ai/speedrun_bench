{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": {
      "*": "allow"
    }
  },
  "provider": {
    "kimi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi (vLLM)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "moonshotai/Kimi-K2.7-Code": {
          "name": "Kimi K2.7-Code",
          "options": {
            "chat_template_kwargs": {
              "thinking": false
            }
          },
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "moonshotai/Kimi-K3": {
          "name": "Kimi K3",
          "options": {
            "reasoningEffort": "max",
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "mimo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MiMo (vLLM)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "XiaomiMiMo/MiMo-V2.5": {
          "name": "MiMo V2.5",
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false
            }
          },
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenAI GPT-5.6",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          }
        }
      }
    },
    "glm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "GLM (Baseten)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.2": {
          "name": "GLM 5.2",
          "options": {
            "reasoningEffort": "max",
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "inkling": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Inkling (Baseten)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "thinkingmachines/inkling": {
          "name": "Inkling",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "thinkingmachines/inkling-small": {
          "name": "Inkling Small",
          "options": {
            "reasoningEffort": "max",
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (Baseten)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4-Flash-0731": {
          "name": "DeepSeek V4 Flash 0731",
          "options": {
            "reasoningEffort": "max",
            "reasoning_effort": "max"
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "deepseek-ai/DeepSeek-V4-Pro-0813": {
          "name": "DeepSeek V4 Pro 0813",
          "limit": {
            "context": 200000,
            "output": 64000
          }
        }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "x-ai/grok-4.6": {
          "name": "Grok 4.6",
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          },
          "limit": {
            "context": 500000,
            "output": 32768
          }
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5 (via OpenRouter)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "temperature": false
        },
        "anthropic/claude-fable-5.1": {
          "name": "Claude Fable 5.1 (via OpenRouter)",
          "limit": {
            "context": 1000000,
            "output": 128000
          },
          "temperature": false
        },
        "z-ai/glm-5.3": {
          "name": "GLM 5.3 (OpenRouter)",
          "limit": {
            "context": 200000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          }
        },
        "google/gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (via OpenRouter)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "options": {
            "reasoningEffort": "xhigh",
            "reasoning_effort": "xhigh"
          }
        }
      }
    },
    "anthropic": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Anthropic (direct, OpenAI-compatible route)",
      "options": {
        "baseURL": "https://api.anthropic.com/v1",
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      },
      "models": {
        "claude-opus-5": {
          "name": "Claude Opus 5"
        }
      }
    },
    "gemini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini (Google AI Studio, OpenAI-compatible)",
      "options": {
        "baseURL": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "apiKey": "{env:GEMINI_API_KEY}"
      },
      "models": {
        "gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "options": {
            "reasoningEffort": "high",
            "reasoning_effort": "high"
          }
        }
      }
    },
    "geminiproxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Compatibility proxy (schema sanitising + param stripping)",
      "options": {
        "baseURL": "{env:SWEEP_API_BASE}",
        "apiKey": "{env:SWEEP_API_KEY}"
      },
      "models": {
        "google/gemini-3.7-flash": {
          "name": "Gemini 3.7 Flash (schema-proxied)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "options": {
            "reasoningEffort": "high",
            "reasoning_effort": "high"
          }
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5 (via compat proxy)",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "temperature": false
        }
      }
    }
  }
}
